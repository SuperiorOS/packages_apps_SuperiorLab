<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/misc_title"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings">

    <!-- Ignore Secure Window -->
    <com.superior.support.preferences.GlobalSettingSwitchPreference
        android:key="window_ignore_secure"
        android:title="@string/ignore_window_secure_title"
        android:summary="@string/ignore_window_secure_summary"
        android:defaultValue="false" />

    <!-- Google Play Integrity -->
    <com.superior.support.preferences.SystemPropertySwitchPreference
        android:key="persist.sys.pihooks.pi"
        android:title="@string/pi_spoof_title"
        android:summary="@string/pi_spoof_summary"
        android:defaultValue="true" />

    <com.superior.lab.fragments.KeyboxDataPreference
        android:key="keybox_data_setting"
        android:title="@string/keybox_data_title"
        android:summary="@string/keybox_data_summary"
        android:defaultValue=""/>
</PreferenceScreen>
