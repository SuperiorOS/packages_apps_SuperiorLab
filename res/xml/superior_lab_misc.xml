<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/misc_title"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings">

    <!-- Hide developer status in about phone -->
    <Preference
        android:key="hide_developer_status_settings"
        android:title="@string/hide_developer_status_title"
        android:summary="@string/hide_developer_status_summary"
        android:fragment="com.superior.lab.fragments.HideDeveloperStatusSettings"
        settings:controller="com.superior.lab.fragments.HideDeveloperStatusPreferenceController" />

    <!-- Hide app list -->
    <Preference
        android:key="hide_applist_setting"
        android:title="@string/hide_applist_title"
        android:summary="@string/hide_applist_summary"
        android:fragment="com.superior.lab.fragments.HideAppListSettings" />

    <!-- Play Integrity Fix -->
    <Preference
        android:key="play_integrity_fix"
        android:title="@string/spoof_pif_title"
        android:summary="@string/spoof_pif_summary"
        android:fragment="com.superior.lab.fragments.PlayIntegrityFix" />

    <!-- TrickyStore -->
    <Preference
        android:key="tricky_store"
        android:title="@string/spoof_ts_title"
        android:summary="@string/spoof_ts_summary"
        android:fragment="com.superior.lab.fragments.TrickyStore" />

    <!-- App Spoofing -->
    <Preference
        android:key="app_spoofing"
        android:title="@string/spoof_ap_title"
        android:summary="@string/spoof_ap_summary"
        android:fragment="com.superior.lab.fragments.AppSpoofing" />

    <!-- Ignore Secure Window -->
    <com.superior.support.preferences.GlobalSettingSwitchPreference
        android:key="window_ignore_secure"
        android:title="@string/ignore_window_secure_title"
        android:summary="@string/ignore_window_secure_summary"
        android:defaultValue="false" />

    <com.superior.support.preferences.GlobalSettingSwitchPreference
        android:key="hide_screen_capture_status"
        android:title="@string/hide_screen_capture_status_title"
        android:summary="@string/hide_screen_capture_status_summary"
        android:defaultValue="false"/>
</PreferenceScreen>
